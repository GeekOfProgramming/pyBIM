{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pybim",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "CONTACT_TO": "support@pybim.com",
    "EMAIL_FROM": "pyBIM Support <support@pybim.com>",
    "EMAIL_TRANSPORT": "resend",
    "SUPPORT_REPLY_TO": "support@pybim.com"
  }
}
