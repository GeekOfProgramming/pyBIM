# =============================================================================
# pyBIM Environment Configuration Template
# Safe placeholders for production, development, and preview environments.
# NEVER commit production secrets or real credentials to source control.
# =============================================================================

# Environment ('production' | 'staging' | 'development')
ENVIRONMENT=development

# Canonical Site URLs
NEXT_PUBLIC_SITE_URL=https://www.pybim.com
NEXT_PUBLIC_SITE_URL_IT=https://www.pybim.it

# Outbound Email Delivery (Resend API is authoritative in production)
EMAIL_TRANSPORT=resend
RESEND_API_KEY=re_replace_with_your_resend_api_key
EMAIL_FROM=pyBIM Support <support@pybim.com>
CONTACT_TO=support@pybim.com
SUPPORT_REPLY_TO=support@pybim.com

# SMTP Delivery (Development / Testing fallback)
# Active when EMAIL_TRANSPORT=smtp or when RESEND_API_KEY is not set
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=support@pybim.com

# Cloudflare Turnstile (Bot protection for contact, careers, and ROI forms)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Google Analytics 4 (Consent Mode managed build-time public variable)
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Security & Authentication (Client portal fail-closed JWT verification)
JWT_SECRET=replace-with-a-secure-random-secret-key-min-32-chars

# Portal Staging / Test Credentials (Optional for staging test access)
STAGING_PORTAL_EMAIL=demo@pybim.it
STAGING_PORTAL_PASSWORD=replace-with-staging-test-password

# Feature Flags
# When false, intakes gracefully indicate maintenance/disabled state
CAREERS_INTAKE_ENABLED=true
