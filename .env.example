# =============================================================================
# pyBIM Environment Configuration Template
# Safe placeholders for staging and development.
# NEVER commit production secrets or real credentials to source control.
# =============================================================================

# Environment ('production' | 'staging' | 'development')
ENVIRONMENT=staging

# Canonical Site URL (Preferred host format without www)
NEXT_PUBLIC_SITE_URL=https://pybim.com

# SMTP Delivery (Contact form, Early Access queue, and ROI matrix notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=info@pybim.com
CONTACT_TO=info@pybim.com

# Security & Authentication (Client portal fail-closed JWT verification)
JWT_SECRET=replace-with-a-secure-random-secret-key-min-32-chars

# Portal Staging Testing Credentials (Optional for staging test access)
STAGING_PORTAL_EMAIL=portal-tester@pybim.com
STAGING_PORTAL_PASSWORD=replace-with-staging-test-password

# Feature Flags
# When false, intakes gracefully indicate maintenance/disabled state
ROI_GENERATION_ENABLED=false
CAREERS_INTAKE_ENABLED=false

# Media Delivery (Cloudinary asset hosting - optional)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
